# Banco de dados
DATABASE_URL="postgresql://USUARIO:SENHA@127.0.0.1:5432/vitalissy"

# JWT (tambem usado para derivar a chave de criptografia AES dos tokens de wearables)
JWT_SECRET="TROQUE_POR_UM_SEGREDO_FORTE_E_LONGO"
JWT_EXPIRES_IN="7d"

# Servidor
PORT=3001
NODE_ENV=production

# CORS / URL publica do frontend (multiplas origens separadas por virgula)
CORS_ORIGIN="https://app.vitalissy.com.br"
APP_URL="https://app.vitalissy.com.br"

# Upload de arquivos (disco local)
UPLOAD_DIR="./uploads"

# Wearables - opcional, so necessario para a integracao real com Fitbit
FITBIT_CLIENT_ID=""
FITBIT_CLIENT_SECRET=""
FITBIT_REDIRECT_URI="https://app.vitalissy.com.br/api/wearables/fitbit/callback"

# Reservadas para integracoes futuras (nao usadas no codigo atual)
GOOGLE_FIT_CLIENT_ID=""
GOOGLE_FIT_CLIENT_SECRET=""
GARMIN_CLIENT_ID=""
GARMIN_CLIENT_SECRET=""
APPLE_HEALTH_TEAM_ID=""
APPLE_HEALTH_KEY_ID=""

# Pagamentos: ainda nao implementado nesta versao (stub).
# GET /api/payments/products funciona (le do banco), POST /api/payments/checkout
# retorna 503 "em breve". Nao ha variaveis de Stripe/gateway a configurar por enquanto.
