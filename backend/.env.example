# Banco de dados
DATABASE_URL=postgresql://user:password@localhost:5432/vitalissy

# JWT (tambem usado para derivar a chave de criptografia AES dos tokens de wearables)
JWT_SECRET=generate-a-random-32plus-char-hex-secret
JWT_EXPIRES_IN=7d

# Servidor
PORT=3001
NODE_ENV=development

# CORS / URL publica do frontend (multiplas origens separadas por virgula)
CORS_ORIGIN=http://localhost:8080
APP_URL=http://localhost:8080

# Upload de arquivos (disco local)
UPLOAD_DIR=./uploads

# Wearables - opcional, so necessario para a integracao real com Fitbit
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
FITBIT_REDIRECT_URI=

# Reservadas para integracoes futuras (nao usadas no codigo atual)
GOOGLE_FIT_CLIENT_ID=
GOOGLE_FIT_CLIENT_SECRET=
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
APPLE_HEALTH_TEAM_ID=
APPLE_HEALTH_KEY_ID=
